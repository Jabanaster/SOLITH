{
  "name": "solith-hub-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Solith Definition Hub API on Cloudflare Workers and D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create solith-hub-db",
    "db:migrate:local": "wrangler d1 migrations apply solith-hub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply solith-hub-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.5",
    "solith": "file:..",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260723.1",
    "miniflare": "^4.20260721.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.3"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "undici": "7.29.0"
  }
}
