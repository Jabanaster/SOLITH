{
  "name": "resourceforge",
  "version": "1.0.0",
  "description": "A premium local game trainer and save editor platform",
  "main": "dist/electron/main/main.js",
  "bin": {
    "resourceforge": "./dist/electron/main/main.js"
  },
  "scripts": {
    "dev": "concurrently \"electron .\" \"wait-on http://localhost:3000 && electron --remote-devtools",
    "build": "npm run compile && electron-builder --win",
    "build:dir": "npm run compile && electron-builder --dir",
    "start": "electron .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx --fix",
    "agentbridge": "node workflow/agentbridge/agentbridge.js",
    "build:agentbridge": "node scripts/build-agentbridge.js",
    "verify:agentbridge": "node scripts/verify-agentbridge.js",
    "smoke:agentbridge": "npx tsx scripts/smoke-agentbridge-real-task.ts",
    "test:relay": "node scripts/test-file-relay-flow.js",
    "test:codex-relay": "npx tsx scripts/test-codex-relay-flow.ts",
    "test:agentbridge-v11": "npx tsx scripts/test-agentbridge-v11.ts",
    "test:router": "npx tsx scripts/test-router.ts",
    "compile": "tsc"
  },
  "keywords": [
    "game",
    "trainer",
    "save-editor",
    "resource-editor",
    "windows"
  ],
  "author": "ResourceForge Team",
  "license": "MIT",
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "concurrently": "^9.1.2",
    "electron": "^36.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.resourceforge.app",
    "productName": "ResourceForge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/electron/**/*",
      "src/**/*",
      "package.json",
      "demo-game/**/*",
      "Docs/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
