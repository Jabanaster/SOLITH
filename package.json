    "test:live-memory": "node scripts/run-node-tests.mjs test:live-memory",
    "pretest": "node scripts/check-node.mjs && node scripts/ensure-electron-host-entry.mjs",
    "prebuild": "node scripts/check-node.mjs",
    "test": "node scripts/run-node-tests.mjs test",
    "test:definitions": "tsx --test tests/definitions-schema.v1.test.ts tests/target-metadata.test.ts tests/definitions-export.v1.test.ts tests/definitions-compile.v1.test.ts tests/definitions-trainer-controls.v1.test.ts tests/bundled-definition-seed.test.ts tests/cheat-hotkey-slots.test.ts tests/ct-import.test.ts tests/ct-metadata.test.ts tests/ue-dumpspace-import.test.ts tests/script-research.test.ts tests/binary-save-formats.test.ts tests/binary-save-field.test.ts tests/binary-field-proposal.test.ts tests/binary-save-research.test.ts tests/trainer-hotkey-bindings.test.ts tests/trainer-hotkeys.test.ts tests/settings-onboarding.test.ts tests/in-process-script.test.ts tests/in-process-script/hook-engine-aob-migration.test.ts tests/schema-v1-capability-lanes.test.ts tests/schema-v1-dual-read.test.ts tests/schema-v1-phase3-silence.test.ts",
    "test:cheat-toggle": "tsx --test tests/cheat-toggle-store.test.ts",
    "test:trainer-catalog": "tsx --test tests/trainer-catalog.test.ts tests/trainer-catalog-offline.test.ts tests/trainer-catalog-reconcile.test.ts tests/trainer-catalog-ipc-validation.test.ts tests/trainer-catalog-search.test.ts tests/trainer-catalog-full-window.test.ts tests/trainer-catalog-edition-signal.test.ts tests/trainer-catalog-find-edition-groups.test.ts tests/catalog-definition-export.test.ts tests/ct-import.test.ts tests/ct-library.test.ts tests/ct-import-state.test.ts tests/ct-zip-electron-bridge.test.ts tests/trainer-library-persistence-lifecycle.test.ts tests/add-game-integration.test.ts tests/remote-sync-known-steam-app-id.test.ts",
    "generate:trainer-catalog": "node scripts/generate-trainer-catalog-seed.mjs",
    "prepare:branding": "node scripts/prepare-branding-assets.mjs",
    "scan:installed-games": "tsx scripts/scan-installed-games.mjs",
    "measure:startup": "node scripts/measure-startup.mjs",
    "registry:compile": "tsx scripts/compile-ct-registry.mjs",
    "ct-library:import": "tsx scripts/compile-ct-zip.mjs",
    "registry:inspect": "tsx scripts/inspect-registry.mjs",
    "registry:search": "tsx scripts/search-registry.mjs",
    "runtime:validate-signatures": "tsx scripts/validate-runtime-signatures.mjs",
    "runtime:analyze-aob-repair": "tsx scripts/analyze-aob-repair-candidates.mjs",
    "smoke:runtime-readonly": "tsx scripts/smoke-windows-readonly-runtime.mjs",
    "test:install-discovery": "tsx --test tests/install-discovery-steam.test.ts tests/install-discovery-match.test.ts tests/install-discovery-ambiguous-match.test.ts tests/install-discovery-nested-executable-discovery.test.ts tests/install-discovery-executable-role.test.ts tests/install-discovery-provider-identity.test.ts tests/install-discovery-trainer-applicability.test.ts tests/install-discovery-epic-gog.test.ts tests/install-discovery-xbox.test.ts tests/install-discovery-reconcile-duplicate-executables.test.ts tests/installed-game-identity.test.ts tests/trainer-library-preview-gates.test.ts",
    "test:trainer-health": "tsx --test tests/trainer-health.test.ts tests/trainer-deck-rows.test.ts tests/catalog-demand.test.ts",
    "test:drill-core": "tsx --test tests/drill-core-settings.test.ts",
    "test:electron-smoke": "playwright test tests/electron.smoke.test.ts",
    "test:startup-visibility": "playwright test tests/startup-visibility-behavior.e2e.test.ts --config playwright.e2e.config.ts",
    "test:walkthrough-e2e": "playwright test tests/walkthrough-navigation.e2e.test.ts --config playwright.e2e.config.ts",
    "test:electron-e2e": "playwright test tests/electron.e2e.test.ts --config playwright.e2e.config.ts",
    "test:new1-new2-trust-boundary": "playwright test tests/new1-new2-trust-boundary.e2e.test.ts --config playwright.e2e.config.ts",
    "test:trainer-e2e": "playwright test tests/trainer.e2e.test.ts --config playwright.e2e.config.ts",
    "test:pointer-map-ui-real-process": "playwright test tests/pointer-map-ui-real-process.e2e.test.ts --config playwright.e2e.config.ts",
    "test:pointer-map-ui-packaged": "playwright test tests/pointer-map-ui-packaged.e2e.test.ts --config playwright.e2e.config.ts",
    "test:pointer-map-ui-cancellation": "playwright test tests/pointer-map-ui-cancellation.e2e.test.ts --config playwright.e2e.config.ts",
    "test:pointer-map-ui-cancellation-packaged": "playwright test tests/pointer-map-ui-cancellation-packaged.e2e.test.ts --config playwright.e2e.config.ts",
    "test:pointer-map-ui-stability": "playwright test tests/pointer-map-ui-stability.e2e.test.ts --config playwright.e2e.config.ts",
    "test:packaged-smoke": "playwright test tests/packaged-smoke.test.ts --config playwright.e2e.config.ts",
    "pretest:milestone-e": "npm run build",
    "test:milestone-e": "playwright test tests/milestone-e-acceptance.test.ts --config playwright.e2e.config.ts",
    "test:ipc-channels": "playwright test tests/ipc-channels.e2e.test.ts --config playwright.e2e.config.ts",
    "test:ipc-e2e": "playwright test tests/ipc-channels.e2e.test.ts --config playwright.e2e.config.ts",
    "test:trainer-states": "playwright test tests/trainer-states-controls.e2e.test.ts --config playwright.e2e.config.ts",
    "test:trainer-states-e2e": "playwright test tests/trainer-states-controls.e2e.test.ts --config playwright.e2e.config.ts",
    "test:browser-fallback": "playwright test tests/browser-fallback.e2e.test.ts --config playwright.e2e.config.ts",
    "test:browser-fallback-e2e": "playwright test tests/browser-fallback.e2e.test.ts --config playwright.e2e.config.ts",
    "test:accessibility": "playwright test tests/accessibility.e2e.test.ts --config playwright.e2e.config.ts",
    "test:performance": "playwright test tests/performance.e2e.test.ts --config playwright.e2e.config.ts",
    "test:pilot-intake": "tsx --test tests/pilot-intake.test.ts",
    "verify:electron-output": "node scripts/verify-electron-output.mjs",
    "build:release": "node scripts/run-release-build.mjs build",
    "dist:release": "node scripts/run-release-build.mjs build",
    "release:verify": "node scripts/run-release-build.mjs verify:electron-output verify:release-artifacts",
    "verify:fresh-clone-verification": "node scripts/verify-fresh-clone-verification.mjs",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
    "verify:clean-env": "npm run build && npm test && npm run test:electron-smoke",
    "verify:release-gate": "npm run verify:schema-v1-boundaries && npm run orphan-check && npm run verify:clean-env",
    "checksums:release": "node scripts/generate-release-checksums.mjs",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "postinstall": "patch-package && electron-builder install-app-deps",
    "test:milestone-j": "tsx --test tests/milestone-j-acceptance.test.ts",
    "test:in-process": "tsx --test tests/in-process-script.test.ts tests/in-process-script/hook-engine-aob-migration.test.ts",
    "verify:schema-v1-boundaries": "node scripts/verify-schema-v1-boundaries.mjs",
    "orphan-check": "node scripts/orphan-check.mjs",
    "certify:live-pointer": "tsx scripts/certify-live-pointer.mjs",
    "test:phase3": "tsx --test tests/hub-sync.test.ts tests/community-trust.test.ts tests/community-sync-orchestrator.test.ts tests/write-policy.test.ts",
    "test:registry": "tsx --test tests/registry-query.test.ts tests/registry-schema.test.ts tests/registry-cli.test.ts tests/registry-explorer-page.test.tsx tests/ct-registry.test.ts tests/ce-enrichment.test.ts tests/feature-candidates.test.ts tests/runtime-readonly.test.ts tests/runtime-signature-validation.test.ts tests/headless-verification.test.ts tests/delta-engine.test.ts tests/l4-governance.test.ts",
    "test:companion": "tsx --test tests/companion-wisp.test.ts",
    "test:electron-consent-boundary": "playwright test tests/electron-consent-boundary.e2e.test.ts --config playwright.e2e.config.ts",
    "test:executable-identity": "tsx --test tests/executable-identity-content-hash.test.ts tests/executable-identity-pe-metadata.test.ts tests/executable-identity-catalog-content-hash.test.ts tests/executable-identity-pe-version-info.test.ts"
  },
  "keywords": [
    "trainer",
    "save-editor",
    "game-trainer"
  ],
  "build": {
    "appId": "com.solith.app",
    "productName": "Solith",
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName} Setup ${version}.${ext}",
    "files": [
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "!dist-electron/**/*.bak",
      "!dist-electron/**/*._bak_cert",
      "!dist-electron/**/*.orig",
      "!dist-electron/**/*.tmp",
      "!node_modules/solith-scanner-napi/**"
    ],
    "asarUnpack": [
      "node_modules/sql.js/**",
      "dist-electron/host-entry.js",
      "dist-electron/headless-verification-worker.js",
      "dist-electron/solith-readonly-scanner.exe"
    ],
    "extraResources": [
      {
        "from": "demo-game",
        "to": "demo-game"
      },
      {
        "from": "data/trainer-catalog-seed.json",
        "to": "data/trainer-catalog-seed.json"
      },
      {
        "from": "native/solith-scanner-napi",
        "to": "native/solith-scanner-napi",
        "filter": [
          "index.js",
          "index.d.ts",
          "package.json",
          "*.node"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "Solith",
      "icon": "public/solith-icon.ico"
    },
    "nsis": {
      "artifactName": "Solith Setup ${version}.${ext}",
      "installerIcon": "public/solith-icon.ico",
      "uninstallerIcon": "public/solith-icon.ico",
      "installerHeaderIcon": "public/solith-icon.ico",
      "shortcutName": "Solith",
      "uninstallDisplayName": "Solith",
      "deleteAppDataOnUninstall": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "blake3": "^2.1.7",
    "memoryjs": "file:vendor/memoryjs-3.5.1-patched",
    "node-lief": "^1.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resedit": "^3.1.0",
    "solith-scanner-napi": "file:native/solith-scanner-napi",
    "sql.js": "^1.14.2",
    "tesseract.js": "^7.0.0",
    "xml2js": "^0.6.2",
    "xxhash-wasm": "^1.1.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.2.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.23",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.7",
    "undici": "7.29.0",
    "@xmldom/xmldom": "0.9.12",
    "joi": "18.2.8",
    "@electron/rebuild": {
      "undici": "6.28.0"
    }
  }
}
