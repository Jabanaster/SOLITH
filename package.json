    "build:msix": "node scripts/check-msix-identity-env.mjs && node scripts/generate-msix-assets.mjs && npm run build:vite && npm run build:electron && electron-builder --win appx --config electron-builder.msix.config.cjs",
    "wack:msix": "node scripts/run-wack.mjs",
    "test:v1": "tsx --test tests/core.test.ts tests/parsers.test.ts tests/save-format.test.ts tests/json-save-field.test.ts tests/ini-save-field.test.ts tests/discovery.test.ts tests/safety-integration.test.ts tests/electron-boundary-static.test.ts tests/failure-injection.test.ts tests/delete-game.test.ts tests/profiles.test.ts tests/process.test.ts tests/trainer-ui.test.ts tests/pilot-intake.test.ts tests/drill-core-settings.test.ts tests/game-profile-catalog.test.ts tests/game-profile-review.test.ts tests/game-profile-support-matrix.test.ts tests/v2-safe-workflow-copy.test.ts && tsx --test tests/sql-parameter-binding.test.ts",
