# ── Machine-specific pilot evidence captures (MUST NOT be committed) ─────────
# Wand-monitoring captures and CSV evidence generated on the local machine.
# These are machine-specific process snapshots — not project source.
Docs/pilot/wand-captures/

# ── Real-world pilot data directories (MUST NOT be committed) ────────────────
# These directories hold the user's actual game saves captured during real-world
# compatibility testing. NEVER commit any of these — they may contain personal save data.
.local-pilot-data/
.local-pilot-workspaces/
.local-pilot-backups/
.local-pilot-reports/

# ── Demo game save files should not be committed if they contain real data ──
# The demo-game directory is tracked as fixture data; exclude any accidentally
# generated runtime copies:
demo-game/**/*.bak
demo-game/data/*
!demo-game/data/items.json
!demo-game/data/player_stats.ini

# ── Compat test database (only used by the legacy compat runner) ──────────────
electron/test-compat.db

