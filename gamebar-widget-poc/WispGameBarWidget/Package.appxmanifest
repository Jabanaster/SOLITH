<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 mp rescap">

  <Identity
    Name="Solith.WispGameBarWidget.Poc"
    Publisher="CN=SolithLocalDevPoc"
    Version="0.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="7f2e0c9a-0000-4000-8000-000000000001" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Solith Wisp (Game Bar Widget POC)</DisplayName>
    <PublisherDisplayName>Solith (local proof of concept, unsigned)</PublisherDisplayName>
    <Logo>Assets\solith-wisp-base-float.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="WispGameBarWidget"
      Executable="$targetnametoken$.exe"
      EntryPoint="WispGameBarWidget.App">

      <uap:VisualElements
        DisplayName="Solith Wisp"
        Description="Proof-of-concept Xbox Game Bar widget that displays the Solith Wisp companion over a running game."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\solith-wisp-base-float.png"
        Square44x44Logo="Assets\solith-wisp-base-float.png">
        <uap:DefaultTile Wide310x150Logo="Assets\solith-wisp-base-float.png" />
      </uap:VisualElements>

      <Extensions>
        <!--
          This is the extension that registers the app as a Game Bar widget
          provider. The AppExtension "Name" value MUST be exactly
          "microsoft.gameBarUIExtension" - Game Bar discovers widgets by
          scanning installed packages for this literal string. The extension
          name did NOT change when Microsoft renamed "Overlay"/"UI Extension"
          to "Widget" in SDK 4.1.2003.11001.0 (see Microsoft's "Overlays are
          Widgets" breaking-change note) - only the API surface names changed.
        -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="microsoft.gameBarUIExtension"
            Id="WispGameBarWidgetExtension"
            PublicFolder="Public"
            DisplayName="Solith Wisp"
            Description="Displays the Solith Wisp companion while a game is running.">
            <uap3:Properties>
              <XboxLiveTitleIds xmlns="" />
              <PublisherId xmlns=""></PublisherId>
              <SupportsMultipleInstances xmlns="">false</SupportsMultipleInstances>
              <IsCoreWidget xmlns="">false</IsCoreWidget>
              <PreferredWidth xmlns="">300</PreferredWidth>
              <PreferredHeight xmlns="">300</PreferredHeight>
              <MinimumWidth xmlns="">200</MinimumWidth>
              <MinimumHeight xmlns="">200</MinimumHeight>
              <ActivateAfterInstall xmlns="">true</ActivateAfterInstall>
              <SettingsSupported xmlns="">false</SettingsSupported>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>

    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
