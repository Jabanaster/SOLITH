{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist-electron",
    "rootDir": "./",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "declaration": false,
    "allowImportingTsExtensions": false
  },
  "include": [
    "electron/**/*",
    "src/core/**/*",
    "src/shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "src/app/**/*",
    // electron/run-compat-test.ts is an orphaned developer runner: unreferenced
    // by any package script, build entry, test, or other source file since the
    // repository's initial commit, and it imports a sibling module that does
    // not exist. It is not part of the production Electron compilation
    // boundary; excluded here rather than stubbed or deleted (deletion not
    // authorized).
    "electron/run-compat-test.ts"
  ]
}
